# Generated by scripts/generate-security-headers.cjs — do not hand-edit connect-src API host.
# Browsers keep hashed assets for a year; Cloudflare's EDGE revalidates hourly.
# INCIDENT 2026-07-10: during a deploy the SPA fallback (index.html) was cached
# AT /assets/*.js URLs under the immutable header, breaking boot for every user
# until a manual purge. The bounded edge TTL makes that self-heal within 1h
# while keeping assets warm at the edge for normal browsing sessions.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cloudflare-CDN-Cache-Control: public, max-age=3600

/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
# Boot scripts pair with index.html (CSP forbids inline scripts) and contain
# the stale-cache self-heal — they must never be served stale themselves.
/boot/theme-init.js
  Cache-Control: no-cache, no-store, must-revalidate
/boot/boot-splash.js
  Cache-Control: no-cache, no-store, must-revalidate
/boot/*
  Cache-Control: no-cache, no-store, must-revalidate
# Build version manifest drives live stale-session detection — never cache.
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

