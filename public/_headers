# Generated by scripts/generate-security-headers.cjs — do not hand-edit connect-src API host.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
# Boot scripts pair with index.html (CSP forbids inline scripts) and contain
# the stale-cache self-heal — they must never be served stale themselves.
/boot/theme-init.js
  Cache-Control: no-cache, no-store, must-revalidate
/boot/boot-splash.js
  Cache-Control: no-cache, no-store, must-revalidate
/boot/*
  Cache-Control: no-cache, no-store, must-revalidate

